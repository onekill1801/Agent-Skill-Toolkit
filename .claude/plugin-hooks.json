{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell|Read|Edit|Write|NotebookEdit|Grep",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/.claude/hooks/guard_write.py\" --plugin || python \"${CLAUDE_PLUGIN_ROOT}/.claude/hooks/guard_write.py\" --plugin"
          }
        ]
      }
    ]
  }
}
