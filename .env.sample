GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
# Agent Debate engine (auto-dev/tools/debate_engine.py) mặc định dùng CLI agent bản subscription
# (claude / cursor=binary `agent` / agy) → KHÔNG cần API key. Các khóa dưới CHỈ dùng --backend api:
ANTHROPIC_MODEL=claude-opus-4-8
ANTHROPIC_BASE_URL=https://api.anthropic.com

REQUIRE_APPROVAL=false
ALLOW_SHELL_EXECUTION=true

# SSL Verification (set to false for self-signed certificates in corporate environments)
SSL_VERIFY=true

# Azure DevOps Configuration
AZURE_DEVOPS_ORG=your-organization
AZURE_DEVOPS_PROJECT=your-project
AZURE_DEVOPS_PAT=your-personal-access-token

# GitLab Self-Hosted Configuration
GITLAB_URL=https://gitlab.your-company.com
GITLAB_PRIVATE_TOKEN=your-private-token
GITLAB_PROJECT_ID=123
# Model for auto MR review via `claude -p` (mr_watch.py). Default 'sonnet'; 'opus' for deeper review.
MR_REVIEW_MODEL=sonnet

# ── aTask Automation ─────────────────────────────────────────────
# aTask Automation (comments on separate lines — not inline after values)
ATASK_BASE_URL=ATASK_BASE_URL
ATASK_PAT_TOKEN=your-atask-pat-token
ATASK_PAT_HEADER=ATASK_PAT_HEADER
ATASK_VERIFY_SSL=false
# Session JWT cho REST trực tiếp (GET /api/tasks/{id} — đầy đủ field hơn kênh ai/execute;
# PAT bị 401 ở đó). Lấy từ browser: DevTools -> Network -> request bất kỳ -> header
# "Authorization: Bearer <token>" (chỉ dán phần token). Hết hạn theo session -> dán lại.
ATASK_BEARER_TOKEN=
# Login aTask của tôi — loại khỏi gợi ý assignee khi triage/resolve
ATASK_MY_LOGIN=your-login

# ── Stack-verify toolkit (auto-dev integration tests) ────────────
# Point these at the TEST environment, not production.

# API probe (probe_api.py)
API_BASE_URL=https://your-service.dev
API_AUTH_HEADER=Authorization: Bearer your-test-token

# DB probe (probe_db.py) — wraps psql / mysql CLI (must be on PATH)
DB_HOST=localhost
DB_PORT=
DB_USER=app
DB_PASSWORD=your-db-password
DB_NAME=your_db
# PostgreSQL only: a full libpq URL overrides the discrete vars above
PG_URL=

# Redis probe (probe_redis.py) — speaks RESP over a socket
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# Kafka probe (probe_kafka.py) — via Confluent REST Proxy
KAFKA_REST_URL=http://kafka-rest:8082
KAFKA_REST_AUTH=

# Kafka UI (kafka_ui.py) — Provectus kafka-ui, LOGIN_FORM (form login -> cookie)
# LƯU Ý: nếu mật khẩu chứa '#', PHẢI bọc nháy kép, vd KAFKA_UI_PASSWORD="abc#123"
# (config.py cắt phần sau '#' nếu không có nháy — coi đó là comment inline).
KAFKA_UI_URL=https://kafka-ui.example.com
KAFKA_UI_USER=your-username
KAFKA_UI_PASSWORD=
KAFKA_UI_LOGIN_PATH=/auth

# Jenkins client (jenkins.py)
JENKINS_URL=https://jenkins.your-company.com
JENKINS_USER=your-username
JENKINS_TOKEN=your-api-token

# ── Remote Control (Telegram bridge + SSH fan-out) ───────────────
# Telegram bridge: nhắn tin -> claude -p headless (full agent). Thao tác ghi/SSH/
# nguy hiểm hỏi duyệt bằng nút bấm. Chi tiết: .claude/skills/remote-control/SKILL.md
TELEGRAM_BOT_TOKEN=123456:your-botfather-token
# chat_id được phép điều khiển (cách nhau dấu phẩy). RỖNG = chặn tất cả (fail-closed).
TELEGRAM_ALLOWED_CHATS=
# ── Đa bot (tùy chọn) ─────────────────────────────────────────────
# Bot ở trên (TELEGRAM_BOT_TOKEN) = bot CODE: nhắn -> claude -p full agent.
# Có thể tách thêm bot OPS để gom monitor + thông báo + DUYỆT nút bấm vào một kênh
# riêng cho gọn. TELEGRAM_OPS_BOT RỖNG = TẤT CẢ trên 1 bot (đúng hành vi cũ).
# Set =ops để bật tách (Telegram chỉ cho 1 poller getUpdates mỗi token, nên mỗi
# bot tương tác = 1 token + 1 daemon riêng):
TELEGRAM_OPS_BOT=                     # vd 'ops' -> kích hoạt, dùng các khóa _OPS dưới
TELEGRAM_BOT_TOKEN_OPS=               # token bot ops (từ @BotFather)
TELEGRAM_ALLOWED_CHATS_OPS=           # chat_id kênh ops (nhận thông báo + nút Duyệt)
# (Nâng cao) muốn 3 bot — tách bot notify khỏi bot duyệt; rỗng = theo TELEGRAM_OPS_BOT:
TELEGRAM_NOTIFY_BOT=                  # bot cho thông báo 1 chiều (bg_notify, digest...)
TELEGRAM_APPROVAL_BOT=                # bot hiển thị nút Duyệt/Từ chối
TELEGRAM_APPROVAL_CHAT=               # ép chat đích cho thẻ duyệt (rỗng = allowlist bot duyệt)
# Chạy 2 daemon:
#   python telegram_bridge.py                                  # bot CODE (full)
#   python telegram_bridge.py --bot ops --mode approvals-only  # bot OPS (poller nhẹ)
# Test từng bot:  python tg_api.py me ops   ·   python tg_api.py test ops
TELEGRAM_APPROVAL_TIMEOUT=300         # giây chờ bấm nút trước khi auto-deny
TELEGRAM_AGENT_TIMEOUT=1800           # giây tối đa cho một lượt claude -p
TELEGRAM_AGENT_MODEL=                 # rỗng = model mặc định; vd 'sonnet'
CLAUDE_BIN=                           # rỗng = 'claude' trên PATH
TELEGRAM_LONG_SESSION_TURNS=20        # số lượt thì nhắc /new (ngữ cảnh đã dài)
# Nhiều tài khoản Claude + fallback (đa nền tảng). Danh sách label, ưu tiên trái->phải:
# account đầu chạy trước, lỗi giới hạn/đăng nhập -> tự nhảy account kế. Mỗi label X có home
# mặc định <home>/.claude-X (đổi account = set HOME/USERPROFILE -> claude đọc <home>/.claude).
# Chỉ giữ account nào có sẵn thư mục .claude; máy thường (chỉ ~/.claude) -> tự dùng 'default'.
CLAUDE_ACCOUNTS=work,personal         # rỗng = work,personal
# Override đường dẫn home tuyệt đối cho từng label (tùy chọn, theo OS):
#   Windows:  CLAUDE_HOME_WORK=C:\Users\You\.claude-work
#   macOS:    CLAUDE_HOME_WORK=/Users/you/.claude-work
#   Linux:    CLAUDE_HOME_WORK=/home/you/.claude-work
CLAUDE_HOME_WORK=
CLAUDE_HOME_PERSONAL=
# Tự duyệt (không hỏi) cho nhóm nào: read=đọc, file=sửa/ghi file, bash=lệnh shell ghi (git push,
# restart, ssh ra máy khác, xóa...). 'danger' (rm -rf, shutdown, drop table...) LUÔN hỏi.
# Mặc định read,file. Muốn agent toàn quyền không hỏi: read,file,bash (KHÔNG khuyến nghị).
TELEGRAM_AUTO_APPROVE=read,file
# SSH hosts khai báo trong work/hosts.json (mẫu: skills/remote-control/hosts.sample.json)

# ── TChat Automation (read-only) ──────────────────────────────
# REST base + web origin for TChat (điền domain thật của bạn).
# Auth = session Bearer JWT + x-app header. Get both from a logged-in chat web
# tab: F12 -> Network -> any API request -> Request Headers -> copy 'authorization' and 'x-app'.
FCHAT_BASE_API_URL=https://your-chat-api-host
FCHAT_WEB_ORIGIN=https://your-chat-web-host
FCHAT_BEARER_TOKEN=your-session-jwt
# Refresh token (localStorage 'refreshToken'); enables auto-refresh of the access token.
FCHAT_REFRESH_TOKEN=your-refresh-token
FCHAT_X_APP=your-x-app-header-value
FCHAT_LANG=vi
FCHAT_VERIFY_SSL=true
# E2E decrypt (crypto.py): đường dẫn private key PEM. Dựng bằng
#   python crypto.py unwrap-indexeddb --value '<IndexedDB user_keys[<user>_private]>' \
#          --client-key <clientKey từ /user/me> --save
# Vắng key → messages/listen/group_watch trả ciphertext như cũ (không giải mã).
FCHAT_PRIVATE_KEY_PATH=              # rỗng = work/secrets/fchat_private.pem
# Realtime socket (for send.py). Token defaults to FCHAT_BEARER_TOKEN.
FCHAT_WS_URL=wss://your-chat-realtime-host/realtime
FCHAT_WS_TOKEN=
# Model for auto-reply drafting via `claude -p` (default 'sonnet'; Fable 5 may be gated).
FCHAT_REPLY_MODEL=sonnet
# Quiet-gap (seconds) to wait after the last incoming message before drafting one
# combined reply — lets the other person finish sending. Default 10.
FCHAT_REPLY_DEBOUNCE=10
# group_watch.py: theo dõi MỘT group để lái review MR / build lên dev. Tin khớp
# từ khoá -> giao cho claude -p (full agent); build qua duyệt nút Telegram (cần
# bridge daemon đang chạy). Kết quả báo về cả Telegram lẫn chính group đó.
FCHAT_WATCH_GROUP=                    # id group cần theo dõi (lấy từ `groups.py search`)
FCHAT_WATCH_KEYWORDS=                 # prefilter, phân tách bằng phẩy; rỗng = mặc định
FCHAT_WATCH_TIMEOUT=1800              # giây tối đa cho một lượt claude -p
# Auto-duyệt CHO RIÊNG lượt group_watch: review (post comment) + build lên dev
# không cần bấm nút duyệt ở bot ops (thao tác đã được chấp nhận cho luồng này).
# Tách rời chính sách chung TELEGRAM_AUTO_APPROVE. 'danger' vẫn luôn hỏi. Để 'read'
# nếu muốn build/review vẫn phải duyệt.
FCHAT_WATCH_AUTO_APPROVE=read,file,bash
# task_digest.py --atask: list_task_id đích trên aTask để tạo task từ digest.
# Dùng khi chạy `task_digest.py --atask` mà không truyền --atask-list. Rỗng = tắt.
# LƯU Ý: --atask KHÔNG tự tạo — mỗi flush gửi thẻ DUYỆT (nút ✅/❌) qua Telegram,
# chỉ tạo khi bấm Duyệt. Cần bridge remote-control đang chạy để xử lý nút, và các
# khoá duyệt ở khối TELEGRAM phía trên: TELEGRAM_APPROVAL_BOT / TELEGRAM_OPS_BOT,
# TELEGRAM_APPROVAL_CHAT (hoặc TELEGRAM_ALLOWED_CHATS), TELEGRAM_APPROVAL_TIMEOUT.
FCHAT_DIGEST_ATASK_LIST=
# Timeout RIÊNG cho thẻ duyệt tạo task của digest (giây). Rỗng = theo
# TELEGRAM_APPROVAL_TIMEOUT. Đặt dài để có thời gian bấm duyệt; 86400 = 24h.
# LƯU Ý: wait là blocking — trong lúc chờ, digest tạm dừng flush lô mới (tin vẫn
# được buffer + ghi inbox.jsonl, không mất). Đổi giá trị cần RESTART task_digest.py.
FCHAT_DIGEST_APPROVAL_TIMEOUT=86400
# Model claude -p dùng để trích việc từ lô tin (mặc định 'sonnet').
FCHAT_DIGEST_MODEL=sonnet

# ── aTask triage watcher (atask_watch.py) ────────────────────────
# Poll task đang giao cho tôi -> phân tích -> đề xuất giao-người (assign) hay
# thực hiện tự động (auto-dev) -> gửi đề xuất + nút Duyệt qua Telegram (cần bridge
# daemon chạy). EXECUTE mở auto-dev trong terminal; ASSIGN báo người đề xuất
# (API AI aTask chưa gán assignee-người -> assign tay trong UI).
ATASK_WATCH_INTERVAL=600              # giây giữa các vòng poll
ATASK_WATCH_TIMEOUT=900               # giây tối đa cho lượt phân tích claude -p
ATASK_WATCH_DONE_TYPES=               # statusType coi là xong; rỗng = completed,done,closed,cancelled,rejected
